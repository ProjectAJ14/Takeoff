{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.takeoff.local/import-assets-response.schema.json",
  "title": "ImportAssetsResponse",
  "description": "POST /v1/projects/{id}/assets response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "jobId"
        ],
        "properties": {
          "assetId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "jobId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      },
      "maxItems": 100
    }
  }
}
