{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.takeoff.local/create-project-request.schema.json",
  "title": "CreateProjectRequest",
  "description": "POST /v1/projects body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "settings": {
      "$ref": "edit-plan.schema.json#/$defs/settings"
    }
  }
}
